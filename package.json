{
  "name": "formula-1-node-ts",
  "version": "1.0.0",
  "description": "API REST de Formula 1 em Node.js + TypeScript + Fastify. Evolucao do desafio node-formula-1 da DIO.",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "build": "tsup src/server.ts --format cjs --target node20 --clean",
    "start:dist": "npm run build && node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["nodejs", "typescript", "fastify", "rest-api", "qa", "dio"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.30",
    "tsup": "^8.0.2",
    "tsx": "^4.7.1",
    "typescript": "^5.4.3"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "fastify": "^4.26.2"
  }
}
